       - run: npm ci
 
-      # --publish never: this job only ever produces a local file.
-      # Publishing (if this run is for an actual release) happens
-      # once, later, in the publish job below — see that job and
-      # build-scripts/publish-release.js for why.
       - run: npm run build -- --publish never
 
       - name: Verify the Windows installer was produced
